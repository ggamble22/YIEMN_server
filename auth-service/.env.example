# Copy to .env for `cargo run` (e.g. `set -a; . ./.env; set +a; cargo run`).

# Use `memory` to run with zero dependencies (data is lost on restart).
STORAGE_BACKEND=memory
DYNAMODB_TABLE=auth
# DYNAMODB_ENDPOINT=http://localhost:8000

JWT_SECRET=local-dev-secret-change-me-at-least-32-bytes
JWT_ISSUER=yiemn-auth
ACCESS_TOKEN_TTL_SECS=900
REFRESH_TOKEN_TTL_SECS=2592000

BIND_ADDR=0.0.0.0:8080
METRICS_ADDR=0.0.0.0:9090
RATE_LIMIT_PER_MINUTE=30
TRUST_FORWARDED_FOR=false
CORS_ALLOWED_ORIGINS=http://localhost:3000
REQUEST_TIMEOUT_SECS=10
LOG_FORMAT=pretty
RUST_LOG=info,auth_service=debug
# USER_ICONS=fox,owl,panda,rocket

# Photo icons (local: memory + no moderation; production: s3 + rekognition)
PHOTO_STORAGE=memory
PHOTO_MODERATION=off
# PHOTO_BUCKET=yiemn-user-photos
# S3_ENDPOINT=http://localhost:9000
# PHOTO_PUBLIC_BASE_URL=/v1/photos
# PHOTO_MAX_BYTES=5242880
# PHOTO_ICON_ROLES=student,parent,educator,admin
